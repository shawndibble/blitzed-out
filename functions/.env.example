# Firebase Configuration
# Realtime Database URL. Leave unset in deployed environments: the code derives
# https://$GCLOUD_PROJECT-default-rtdb.firebaseio.com, which cannot drift from
# the project it is deployed to. Set it only for the emulator, or if the database
# lives outside us-central1 (those use *.REGION.firebasedatabase.app).
# Do NOT hardcode another project's host here — a wrong URL does not error, it
# hangs until the function times out.
DATABASE_URL=

# Environment Configuration
# Set to 'production' for production deployment
NODE_ENV=development

# Functions Emulator (automatically set by Firebase CLI)
FUNCTIONS_EMULATOR=true

# Cloudflare Realtime TURN
# Key ID from the Cloudflare dashboard (Realtime > TURN). An identifier, not a
# secret — safe to commit. The paired API token is a Secret Manager secret:
#   firebase functions:secrets:set CLOUDFLARE_TURN_TOKEN
# Leave unset and `getTurnCredentials` fails closed; the client then falls back
# to the relay bundled in its own build.
CLOUDFLARE_TURN_KEY_ID=