{
  "rules": {
    "users": {
      ".read": true,
      "$userId": {
        ".read": true,
        ".write": "auth != null && auth.uid == $userId",
        ".validate": "newData.hasChildren(['displayName', 'lastSeen', 'room', 'isAnonymous']) && newData.child('displayName').isString() && newData.child('lastSeen').isNumber() && newData.child('room').isString() && newData.child('isAnonymous').isBoolean()",
        "lastSeen": {
          ".write": "auth != null && auth.uid == $userId",
          ".validate": "newData.isNumber()"
        }
      }
    },
    "video-calls": {
      "$roomId": {
        "users": {
          ".read": "auth != null",
          "$userId": {
            ".write": "auth != null && auth.uid == $userId",
            ".validate": "newData.hasChildren(['joinedAt', 'status']) && newData.child('joinedAt').isNumber() && newData.child('joinedAt').val() <= now + 60000 && newData.child('status').isString()",
            "joinedAt": {
              ".validate": "newData.isNumber() && newData.val() <= now + 60000"
            },
            "status": {
              ".validate": "newData.isString() && newData.val().length <= 16"
            },
            "lastSeen": {
              ".validate": "newData.isNumber() && newData.val() <= now + 60000"
            },
            "cam": {
              ".validate": "newData.isString() && (newData.val() == 'on' || newData.val() == 'off' || newData.val() == 'none' || newData.val() == 'hidden')"
            },
            "mic": {
              ".validate": "newData.isString() && (newData.val() == 'on' || newData.val() == 'off')"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "offers": {
          "$targetUserId": {
            ".read": "auth != null && auth.uid == $targetUserId",
            ".write": "auth != null",
            "$signalId": {
              ".validate": "newData.child('from').val() == auth.uid"
            }
          }
        },
        "answers": {
          "$targetUserId": {
            ".read": "auth != null && auth.uid == $targetUserId",
            ".write": "auth != null",
            "$signalId": {
              ".validate": "newData.child('from').val() == auth.uid"
            }
          }
        },
        "ice-candidates": {
          "$targetUserId": {
            ".read": "auth != null && auth.uid == $targetUserId",
            ".write": "auth != null",
            "$signalId": {
              ".validate": "newData.child('from').val() == auth.uid"
            }
          }
        }
      }
    },
    ".read": false,
    ".write": false
  }
}
